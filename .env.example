# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# ── Model provider ────────────────────────────────────────────────────────────
# Which adapter to use: gemini | openrouter | anthropic | mock
AI_PROVIDER=gemini

# Gemini (default). Free key, no credit card: https://aistudio.google.com/apikey
# NOTE: enabling billing on the Google Cloud project DELETES the free tier.
# Free tier as of Aug 2026 — 250 req/day, 10 rpm, 250k tpm on gemini-2.5-flash.
GEMINI_API_KEY=

# OpenRouter (fallback / model comparison). https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-4-scout:free

# Anthropic (optional). https://console.anthropic.com
# ANTHROPIC_API_KEY=

# ── Sharing (Phase 4 only — not needed before then) ───────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
